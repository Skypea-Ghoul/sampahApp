      "APP_PACKAGE_CACHE": "tmp/packages.php",
      "APP_SERVICES_CACHE": "tmp/services.php",
      "APP_ROUTES_CACHE": "tmp/routes.php",
      "DB_CONNECTION": "pgsql",
      "DB_URL": "postgres:GjmgZ8XArNkrJebt@db.zqeqcmlhsjhljvmbsiya.supabase.co:5432/postgres",
      "DB_PASSWORD": "GjmgZ8XArNkrJebt",
      "VIEW_COMPILED_PATH": "/tmp",
      "CACHE_DRIVER": "array",
      "LOG_CHANNEL": "stderr",
      "SESSION_DRIVER": "cookie"
    },
    "outputDirectory": "public"
