{
    "version": 2,
    "builds": [
      {
        "src": "./*",
        "use": "@vercel/php@0.6.0",
        "config": {
          "phpVersion": "8.3.13"
        }
      }
    ],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "/public/$1"
      }
    ],
    "env": {
      "APP_ENV": "production",
      "APP_DEBUG": "true",
      "APP_URL": "https://sampah-apssss.vercel.app",
