{
  "version": 2,
  "framework": "laravel",
  "builds": [
    {
      "src": "composer.json",
      "use": "@vercel/php",
      "config": {
        "phpVersion": "8.3",
        "composer": {
          "installFlags": ["--no-dev", "--optimize-autoloader"]
        },
        "outputDirectory": "public"
      }
    }
  ],
  "routes": [
    { "src": "/build/(.*)", "dest": "/public/build/$1" },
    { "src": "/(.*)", "dest": "/public/index.php" }


  ],
  "buildCommand": "composer install --no-dev && php artisan optimize:clear && php artisan config:cache && php artisan route:cache && php artisan view:cache && vite build",
  "outputDirectory": "public"
}